rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProgress(data, userId) {
      return data.userId == userId &&
        data.currentEpisode is number &&
        data.currentEpisode >= 1 &&
        data.currentEpisode <= 500 &&
        data.playbackTime is number &&
        data.playbackTime >= 0 &&
        data.watchedEpisodes is list &&
        data.watchedEpisodes.size() <= 600;
    }

    function isValidSchedule(data, userId) {
      return data.userId == userId &&
        data.episodeNumber is number &&
        data.episodeNumber >= 1 &&
        data.episodeNumber <= 500 &&
        data.episodeTitle is string &&
        data.episodeTitle.size() <= 200 &&
        data.scheduledFor is string &&
        data.scheduledFor.size() <= 100 &&
        data.status in ['pending', 'completed', 'cancelled'];
    }

    match /users/{userId} {
      allow read, write: if false;

      match /progress/{docId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProgress(incoming(), userId);
        allow update: if isOwner(userId) && isValidProgress(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      match /schedules/{scheduleId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(scheduleId) && isValidSchedule(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(scheduleId) && isValidSchedule(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(scheduleId);
      }
    }
  }
}
